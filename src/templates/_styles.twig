{% css %}
.ti-inline-form { display: inline-block; margin: 0; }
.ti-connection { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.ti-connection code { margin-left: 4px; }
.ti-check { color: var(--green-600, #0d9488); font-weight: 700; }
.ti-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; margin-bottom: 24px; }
.ti-stat { border: 1px solid var(--hairline-color, #e3e5e8); border-radius: var(--large-border-radius, 8px); padding: 14px 16px; }
.ti-stat-value { font-size: 1.6em; font-weight: 600; line-height: 1.2; }
.ti-stat-label { color: var(--light-text-color, #606d7b); font-size: .9em; }
.ti-meta { display: grid; grid-template-columns: max-content 1fr; gap: 6px 24px; margin: 0; }
.ti-meta dt { color: var(--light-text-color, #606d7b); }
.ti-meta dd { margin: 0; }
.ti-source { border: 1px solid var(--hairline-color, #e3e5e8); border-radius: var(--large-border-radius, 8px); margin-bottom: 20px; overflow: hidden; }
.ti-source-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 12px 16px; background: var(--gray-050, #f3f7fc); border-bottom: 1px solid var(--hairline-color, #e3e5e8); }
.ti-source-header h3 { margin: 0; }
.ti-source-body { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 24px; padding: 16px; }
@media (max-width: 900px) { .ti-source-body { grid-template-columns: 1fr; } }
.ti-source-body h4 { margin: 0 0 8px; }
.ti-code { margin: 0; padding: 10px 12px; border-radius: var(--medium-border-radius, 5px); background: var(--gray-050, #f3f7fc); font-family: var(--code-font, monospace); font-size: .9em; white-space: pre-wrap; word-break: break-word; }
.ti-badge { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: .85em; background: var(--gray-100, #e4edf6); color: var(--text-color, #1f2937); white-space: nowrap; }
.ti-badge.ti-warn { background: var(--yellow-050, #fef9c3); color: var(--yellow-800, #854d0e); }
.ti-badge.ti-ok { background: var(--teal-050, #ccfbf1); color: var(--teal-800, #115e59); }
.ti-sources-list { display: flex; flex-wrap: wrap; gap: 4px; }
.ti-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
.ti-pagination { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 16px; }
.ti-actions { display: flex; gap: 6px; justify-content: flex-end; align-items: center; flex-wrap: wrap; }
td .ti-actions { flex-wrap: nowrap; }
.ti-sample { max-height: 320px; overflow: auto; }
.ti-section-title { margin: 28px 0 12px; }
{% endcss %}
